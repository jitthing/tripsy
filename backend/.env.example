PORT=8080
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
CORS_ORIGINS=http://localhost:5173,https://app.example.com
APP_URL=http://localhost:5173
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
RESEND_API_KEY=re_<key>
RESEND_WEBHOOK_SECRET=whsec_<secret>
RESEND_INBOUND_DOMAIN=<your-resend-domain>.resend.app
# Central address receiving all forwarded confirmations (optional in legacy per-trip mode)
RESEND_INBOUND_ADDRESS=inbox@<your-resend-domain>.resend.app
# Supabase user id that owns the central inbox
RESEND_INBOUND_OWNER_ID=<your-user-uuid>
GEMINI_API_KEY=<server-only-key>
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CALENDAR_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CALENDAR_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALENDAR_REDIRECT_URL=http://localhost:8080/calendar/callback
GOOGLE_OAUTH_STATE_SECRET=<long-random-secret>
GOOGLE_TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
